# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 각 값은 해당 단계에서 추가된다.

# 로컬 인프라 (0단계). 비워 두면 infra/compose.yaml의 기본값을 쓴다. 로컬 전용 값이다.
POSTGRES_USER=proofgraph
POSTGRES_PASSWORD=proofgraph
POSTGRES_DB=proofgraph
POSTGRES_PORT=5432
REDIS_PORT=6379

# Claude API (1단계, 1.9)
ANTHROPIC_API_KEY=

# GitHub 수집 (1단계, 1.7)
GITHUB_TOKEN=
